rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The mobile app accesses Firestore only through the Cloud Run API.
    // Firebase Admin SDK requests from the backend are authorized by IAM
    // and are not evaluated against these client security rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
